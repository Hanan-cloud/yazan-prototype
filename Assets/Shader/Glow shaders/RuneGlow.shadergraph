{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "0d1df13c80e445419f3c2455daf436ae",
    "m_Group": {
        "m_Id": "559e742039514e409863a12784d476b5"
    },
    "m_Name": "RuneGlow (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -206.95970153808595,
            "y": 653.4712524414063,
            "width": 0.0,
            "height": 0.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "1ee50456386246f4976fecde1caf7f04"
        },
        {
            "m_Id": "d31af4b59b3445259928d1df417b0151"
        },
        {
            "m_Id": "d8ea3d88b4d3420dbcd528be622a334d"
        },
        {
            "m_Id": "80c584a6850a488e90f3c9dd8a60ae90"
        },
        {
            "m_Id": "ebcd6f84d0ae4aff95e958ae1b1ee0c1"
        },
        {
            "m_Id": "13915585bc4744e0833c70b931ffcfce"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "RuneGlow",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float sum = 0.0;\r\nfloat2 r = TexelSize * Radius;\r\n\r\n[unroll]\r\nfor (int i = 0; i < 8; i++)\r\n{\r\n    float a = i * 0.785398;              // step of 45 degrees\r\n    float2 dir = float2(cos(a), sin(a));\r\n    sum += SAMPLE_TEXTURE2D(Tex.tex, Samp.samplerstate, UV + dir * r).a;        // outer ring\r\n    sum += SAMPLE_TEXTURE2D(Tex.tex, Samp.samplerstate, UV + dir * r * 0.5).a;  // inner ring\r\n}\r\nGlow = sum / 16.0;"
}

