      "pageFiles": [
        {
          "key": "Panel_1",
          "originalValue": "\u064A\u0632\u0646 \u0627\u062D\u0643 \u0644\u0646\u0627 \u0642\u0635\u0629",
          "variants": [
            {
              "language": "en",
              "_value": "The family gathers around the fire as the sun goes down. Yazan sits among them, the cloth doll beside him on the ground. His father turns to him and asks for a story. He looks down. He has nothing.\r\n"
            }
          ],
          "aliases": []
        },
        {
          "key": "Panel_2",
          "originalValue": "\u2026\u2026..",
