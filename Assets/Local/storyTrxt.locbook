{
  "pages": [
    {
      "pageId": "IntroStory",
      "aboutPage": "New Page",
      "pageFiles": [
        {
          "key": "Panel_1",
          "originalValue": "",
          "variants": [
            {
              "language": "en",
              "_value": "As the sun sets, the family gathers around the fire"
            }
          ],
          "aliases": []
        },
        {
          "key": "Panel_2",
          "originalValue": "",
          "variants": [
            {
              "language": "en",
              "_value": "Yazan sits among them, holding his cloth doll."
            }
          ],
          "aliases": []
        },
        {
          "key": "Panel_3",
          "originalValue": "",
          "variants": [
            {
              "language": "en",
              "_value": "father turns to him"
            }
          ],
          "aliases": []
        },
        {
          "key": "Panel_4",
          "originalValue": "",
          "variants": [
            {
              "language": "en",
              "_value": " FATHER:  \u201CTell us a story\u201D"
            }
          ],
          "aliases": []
        },
        {
          "key": "Panel_5",
          "originalValue": "",
          "variants": [
            {
              "language": "en",
              "_value": "Yazan lowers his eyes. He has no story to tell"
            }
          ],
          "aliases": []
        },
        {
          "key": "Panel_6",
          "originalValue": "",
          "variants": [
            {
              "language": "en",
              "_value": "He picks up his backpack and doll and wanders off to explore the valley"
            }
          ],
          "aliases": []
        },
        {
          "key": "Panel_7",
          "originalValue": "",
          "variants": [
            {
              "language": "en",
              "_value": "MOTHER: \u201CYazan\u2026 don\u2019t go too far. There are frightening stories about this place\u201D"
            }
          ],
          "aliases": []
        },
        {
          "key": "Panel_8",
          "originalValue": "",
          "variants": [
            {
              "language": "en",
              "_value": "YAZAN: \u201CI have my doll with me\u2026 I won\u2019t get lost\u201D"
            }
          ],
          "aliases": []
        },
        {
          "key": "Panel_9",
          "originalValue": "",
          "variants": [
            {
              "language": "en",
              "_value": "Yazan continues on his way"
            }
          ],
          "aliases": []
        },
        {
          "key": "Panel_10",
          "originalValue": "",
          "variants": [
            {
              "language": "en",
              "_value": "Yazan thinks he knows the way back. But the valley changes with every step"
            }
          ],
          "aliases": []
        },
        {
          "key": "Panel_11",
          "originalValue": "",
          "variants": [
            {
              "language": "en",
              "_value": "Every rock resembles another. Every path leads to one just like it, until he can no longer remember which way he came"
            }
          ],
          "aliases": []
        },
        {
          "key": "Panel_12",
          "originalValue": "",
          "variants": [
            {
              "language": "en",
              "_value": "Suddenly, nails begin piercing the doll, one after another, until there are ten"
            }
          ],
          "aliases": []
        },
        {
          "key": "Panel_13",
          "originalValue": "",
          "variants": [
            {
              "language": "en",
              "_value": "He looks down at his doll, holding it carefully with tears in his eyes. Then, a light appears before him"
            }
          ],
          "aliases": []
        },
        {
          "key": "Panel_14",
          "originalValue": "",
          "variants": [
            {
              "language": "en",
              "_value": "Yazan follows the light between rocks and forgotten paths until he reaches an ancient wall. "
            }
          ],
          "aliases": []
        },
        {
          "key": "Panel_16",
          "originalValue": "",
          "variants": [
            {
              "language": "en",
              "_value": " The old jinn studies the boy for a long moment. Then he speaks.\r\nGATEKEEPER: \u201CYou are not lost, child\u2026 you are somewhere else entirely\u201D"
            }
          ],
          "aliases": []
        },
        {
          "key": "Panel_17",
          "originalValue": "",
          "variants": [
            {
              "language": "en",
              "_value": "GATEKEEPER: \u201CThis is Alkhafa\u2026 a world beside your own, hidden from human eyes. It was once full of life\u2026\u0022"
            }
          ],
          "aliases": []
        },
        {
          "key": "Panel_19",
          "originalValue": "",
          "variants": [
            {
              "language": "en",
              "_value": "The Gatekeeper lowers his gaze to the doll in Yazan\u2019s hand and points to it\r\n                                    \r\n"
            }
          ],
          "aliases": []
        },
        {
          "key": "Panel_20",
          "originalValue": "",
          "variants": [
            {
              "language": "en",
              "_value": "GATEKEEPER: \u201CStart in either direction, left or right. In each loop, you may find something that does not belong\u201D  "
            }
          ],
          "aliases": []
        },
        {
          "key": "Panel_15",
          "originalValue": "",
          "variants": [
            {
              "language": "en",
              "_value": "There, he finds an ancient, motionless figure standing in the shadows, holding a lantern\u2026unlike anything he has ever seen"
            }
          ],
          "aliases": []
        },
        {
          "key": "Panel_18",
          "originalValue": "",
          "variants": [
            {
              "language": "en",
              "_value": " GATEKEEPER: \u0022 Now it\u2019s sick. It has forgotten its own shape, repeating itself again and again, searching for what was taken from it\u201D"
            }
          ],
          "aliases": []
        },
        {
          "key": "Panel_21",
          "originalValue": "",
          "variants": [
            {
              "language": "en",
              "_value": "GATEKEEPER: \u201C If you notice a change, turn back the way you came. If you find nothing, keep going in the same direction.\u0022 "
            }
          ],
          "aliases": []
        },
        {
          "key": "Panel_22",
          "originalValue": "",
          "variants": [
            {
              "language": "en",
              "_value": "Gatekeeper: \u201CEach correct choice frees a nail. One mistake brings them all back.\u201D "
            }
          ],
          "aliases": []
        },
        {
          "key": "Panel_23",
          "originalValue": "",
          "variants": [
            {
              "language": "en",
              "_value": "Gatekeeper: \u201CThe doll knows\u2026 trust what it shows you. But remember, the doll itself might be an anomaly. Go now\u2026 I\u2019ll be here.\u201D"
            }
          ],
          "aliases": []
        }
      ]
    }
  ],
  "keysLocked": false,
  "originalValuesLocked": false,
  "lockedLanguages": "",
  "pageIdsLocked": false,
  "aboutPagesLocked": false,
  "aliasesLocked": false,
  "encryptedPassword": ""
}