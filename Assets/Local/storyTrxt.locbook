          "key": "Panel_1",
          "originalValue": "\u0647\u0630\u0627 \u0627\u0644\u0646\u0635 \u0627\u0644\u0623\u0648\u0644 \u0645\u0646 \u0627\u0644\u0642\u0635\u0629",
